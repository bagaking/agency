{
  "name": "agency-editor",
  "productName": "Agency",
  "description": "Agency editor desktop app",
  "author": "Agency",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "main": ".electron-build/main.js",
  "scripts": {
    "dev:renderer": "tsx scripts/dev-renderer.ts",
    "dev:main": "tsx scripts/dev-main.ts",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "build:renderer": "vite build",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:agency-data": "pnpm --filter @agency/agency-data run build",
    "file-intent:cli": "pnpm run build:electron && node .electron-build/cli/fileIntentCli.js",
    "session-runtime:cli": "pnpm run build:electron && node .electron-build/cli/sessionRuntimeCli.js",
    "build:speech-helper": "tsx scripts/build-speech-helper.ts",
    "package": "pnpm run build:renderer && pnpm run build:electron && pnpm run build:speech-helper && PNPM_BIN_DIR=$(pnpm bin -g) && PATH=\"$PNPM_BIN_DIR:$PATH\" PNPM_HOME=\"$PNPM_BIN_DIR\" TMPDIR=/tmp electron-builder --mac",
    "package:dir": "pnpm run build:renderer && pnpm run build:electron && pnpm run build:speech-helper && PNPM_BIN_DIR=$(pnpm bin -g) && PATH=\"$PNPM_BIN_DIR:$PATH\" PNPM_HOME=\"$PNPM_BIN_DIR\" TMPDIR=/tmp electron-builder --mac --dir",
    "preview": "vite preview",
    "test:unit": "tsx scripts/run-unit.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "postinstall": "tsx scripts/postinstall.ts",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "pnpm --filter @agency/agency-data run build && tsc --noEmit -p tsconfig.electron.json",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron"
  },
  "build": {
    "appId": "com.agency.editor",
    "productName": "Agency",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist/release",
      "buildResources": "renderer/public"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      ".electron-build/**/*",
      "shared/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "electron/native/speech-helper/bin/AgencySpeechHelper.app",
        "to": "speech-helper/AgencySpeechHelper.app"
      }
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "renderer/public/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice input needs microphone access to capture speech for memos.",
        "NSSpeechRecognitionUsageDescription": "Voice input uses speech recognition to transcribe memos."
      }
    }
  },
  "dependencies": {
    "@agency/agency-data": "workspace:*",
    "@bagakit/open-agent-avatars": "^0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@rive-app/react-canvas": "^4.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^22.1.0",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  }
}
