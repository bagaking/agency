{
  "name": "agency-editor",
  "productName": "Agency",
  "description": "Agency editor desktop app",
  "author": "Agency",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "node scripts/dev-renderer.js",
    "dev:main": "node scripts/dev-main.js",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "build:renderer": "vite build",
    "build:speech-helper": "node scripts/build-speech-helper.js",
    "package": "pnpm run build:renderer && pnpm run build:speech-helper && PNPM_BIN_DIR=$(pnpm bin -g) && PATH=\"$PNPM_BIN_DIR:$PATH\" PNPM_HOME=\"$PNPM_BIN_DIR\" TMPDIR=/tmp electron-builder --mac",
    "package:dir": "pnpm run build:renderer && pnpm run build:speech-helper && PNPM_BIN_DIR=$(pnpm bin -g) && PATH=\"$PNPM_BIN_DIR:$PATH\" PNPM_HOME=\"$PNPM_BIN_DIR\" TMPDIR=/tmp electron-builder --mac --dir",
    "preview": "vite preview",
    "test:e2e": "node scripts/run-e2e.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "build": {
    "appId": "com.agency.editor",
    "productName": "Agency",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist/release",
      "buildResources": "renderer/public"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "electron/native/speech-helper/bin/SpeechHelper.app",
        "to": "speech-helper/SpeechHelper.app"
      }
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "renderer/public/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voice input needs microphone access to capture speech for memos.",
        "NSSpeechRecognitionUsageDescription": "Voice input uses speech recognition to transcribe memos."
      }
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@rive-app/react-canvas": "^4.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^22.1.0",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  }
}
