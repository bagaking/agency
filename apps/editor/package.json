{
  "name": "agency-editor",
  "productName": "Agency",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite --port 5173",
    "dev:main": "wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron electron/main.js",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\"",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@rive-app/react-canvas": "^4.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  }
}
