{
  "name": "agency-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build:agency-data": "pnpm --filter @agency/agency-data run build",
    "typecheck:agency-data": "pnpm --filter @agency/agency-data run typecheck",
    "generate:sop": "pnpm --dir apps/editor exec tsx ../scripts/generate-sop.ts",
    "check:governed-js": "sh scripts/check_no_governed_js.sh .",
    "openspec:list": "openspec list",
    "openspec:list:specs": "openspec list --specs",
    "openspec:validate": "openspec validate --strict",
    "openspec:validate:explorer-platform": "openspec validate refactor-explorer-capability-platform --strict"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.2.0"
  }
}
